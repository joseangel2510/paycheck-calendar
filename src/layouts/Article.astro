---
/** Guide/article layout: breadcrumbs, Article + BreadcrumbList schema, prose body, end CTA. */
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_URL, SITE_NAME } from '../config';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  /** ISO date the content was last reviewed, e.g. "2026-07-03". */
  updated: string;
  current?: string;
}

const { title, description, path, h1, updated, current = 'guides' } = Astro.props;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    dateModified: updated,
    author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
    mainEntityOfPage: new URL(path, SITE_URL).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: h1, item: new URL(path, SITE_URL).href },
    ],
  },
];
---

<Base title={title} description={description} path={path} schema={schema} current={current}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <span>{h1}</span>
    </nav>
    <article class="prose article-body">
      <h1>{h1}</h1>
      <p class="updated">Updated {updated} · Reviewed against current federal holiday and payroll calendars</p>
      <slot />
    </article>
    <AdSlot />
    <aside class="cta card">
      <h2>Which months pay <em>you</em> three times?</h2>
      <p>One date. Instant answer. Free, no sign-up — plus calendar export and a printable payday calendar.</p>
      <a class="btn btn-primary" href="/">Find my 3-paycheck months →</a>
    </aside>
  </div>
</Base>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-2);
    padding-block: 1.2rem 0.5rem;
  }
  .article-body {
    margin-top: 0.8rem;
  }
  .updated {
    font-size: 0.85rem;
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .cta {
    margin-top: 3rem;
    padding: clamp(1.4rem, 4vw, 2.2rem);
    text-align: center;
    background:
      linear-gradient(140deg, var(--green-tint), transparent 60%),
      var(--card);
  }
  .cta h2 {
    margin-bottom: 0.5rem;
  }
  .cta h2 em {
    font-style: normal;
    color: var(--green);
  }
  .cta p {
    margin: 0 auto 1.2rem;
    color: var(--ink-2);
  }
</style>
