---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | PaydayCal"
  description="That page doesn't exist — but your 3-paycheck months do. Find them with the free paycheck calendar calculator."
  path="/404/"
>
  <div class="wrap" style="padding-block: 4rem; text-align: center;">
    <h1>404 — no payday here</h1>
    <p style="margin: 1rem auto 2rem; color: var(--ink-2);">
      This page doesn't exist. Your 3-paycheck months, however, definitely do.
    </p>
    <a class="btn btn-primary" href="/">Find my 3-paycheck months →</a>
  </div>
</Base>
